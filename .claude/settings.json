{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npm test)",
      "Bash(npx eslint src tests)",
      "Bash(npx vitest run *)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma migrate diff *)",
      "Bash(npx prisma migrate status)",
      "Bash(npm view *)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-attribution-trailer.sh",
            "timeout": 10,
            "statusMessage": "Checking commit for attribution trailers"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-applied-migrations.sh",
            "timeout": 10,
            "statusMessage": "Checking migration-file protection"
          }
        ]
      }
    ]
  }
}
