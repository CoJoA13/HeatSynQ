DATABASE_URL="postgresql://erp:erp_local_dev@localhost:5432/erp"
DATABASE_URL_TEST="postgresql://erp:erp_local_dev@localhost:5432/erp_test"
SESSION_SECRET="dev-change-me-32-chars-minimum!!"

# Phase 8B: the practice copy (a separate DB + app on port 8080, started with
# `docker compose --profile practice up`). For a LOCAL (non-docker) practice run, point the app at
# erp_practice and set PRACTICE_MODE — but db-identity is authoritative, so a mis-set flag on a
# prod-pointed app is refused, never honored.
DATABASE_URL_PRACTICE="postgresql://erp:erp_local_dev@localhost:5432/erp_practice"
PRACTICE_MODE="false"
