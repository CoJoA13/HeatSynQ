# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# nightly pg_dump backups (production)
/backups

# Codex review, PR #117 (finding #4): the restore runbook's pre-restore safety dump belongs inside
# /backups (already ignored above) — this is defence in depth in case it's ever written elsewhere,
# e.g. by hand, mid-incident, from the wrong directory.
before-restore-*.sql.gz

# prisma client (generated; run `npx prisma generate`)
/prisma/generated

# playwright e2e artifacts (screenshots + video per flow, regenerated by `npm run test:e2e`)
/e2e-artifacts

# Phase 8C: throwaway pg_dump archives written by the E2E backups flow (harness-owned; the
# run.mjs teardown removes the folder, this is the belt).
/e2e-backups
